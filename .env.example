# NeuroSense AI — Environment Variables
# Copy this file to .env and fill in values as needed

# Backend
DATABASE_URL=sqlite:///./neurosense.db
FRONTEND_URL=http://localhost:5173

# Whisper model size: tiny | base | small | medium | large
# Smaller = faster but less accurate. "base" is recommended for demos.
WHISPER_MODEL=base

# Set to "true" to force demo mode (no Whisper transcription)
FORCE_DEMO_MODE=false
